{
  "name": "dnb-task-manager",
  "version": "1.0.0",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng.js",
    "start": "node ./node_modules/@angular/cli/bin/ng.js serve --proxy-config proxy.conf.json",
    "start:dev": "node ./node_modules/@angular/cli/bin/ng.js serve --configuration=dev --proxy-config proxy.conf.json",
    "start:qa": "node ./node_modules/@angular/cli/bin/ng.js serve --configuration=qa",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build",
    "build:dev": "node ./node_modules/@angular/cli/bin/ng.js build --configuration=dev",
    "build:qa": "node ./node_modules/@angular/cli/bin/ng.js build --configuration=qa",
    "build:stg": "node ./node_modules/@angular/cli/bin/ng.js build --configuration=stg",
    "build:prod": "node ./node_modules/@angular/cli/bin/ng.js build --configuration=production",
    "test": "node ./node_modules/@angular/cli/bin/ng.js test",
    "test:ci": "node ./node_modules/@angular/cli/bin/ng.js test --no-watch --code-coverage",
    "watch": "node ./node_modules/@angular/cli/bin/ng.js build --watch --configuration=dev",
    "lint": "node ./node_modules/@angular/cli/bin/ng.js lint"
    
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.0"
  }
}
